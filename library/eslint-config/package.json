{
  "name": "@igeta/eslint-config",
  "version": "0.2.0",
  "description": "Igeta のコーディング規約のうち、機械で落とせる規則を載せた ESLint 9 flat config",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "check-layout.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint --max-warnings 0 test/fixtures/clean"
  },
  "peerDependencies": {
    "eslint": "^9.39.0",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "dependencies": {
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unicorn": "65.0.1",
    "typescript-eslint": "8.72.0"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  },
  "bin": {
    "igeta-check-layout": "./check-layout.js"
  }
}
