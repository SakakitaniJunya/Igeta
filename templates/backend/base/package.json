{
  "name": "__app__-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore --project __emulatorProject__ 'vitest run'",
    "check:deps": "depcruise --config .dependency-cruiser.cjs src",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.10.0",
    "firebase-tools": "^13.29.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
